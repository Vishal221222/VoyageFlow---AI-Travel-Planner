
# VoyageFlow - Multi-Agent AI Travel Planner
# Copy this file to .env for local development.
# Replace placeholders with your actual credentials.

# Groq - AI models
GROQ_API_KEY=your_groq_api_key_here

# Tavily - Web search
TAVILY_API_KEY=your_tavily_api_key_here

# AviationStack - Flight information
AVIATION_STACK_API_KEY=your_aviationstack_api_key_here

# OpenWeather - Weather information
OPENWEATHER_API_KEY=your_openweather_api_key_here

# PostgreSQL database
# For local development, use your Docker connection.
# For deployment, use your cloud database URL.
DATABASE_URL=postgresql://username:password@hostname:5432/voyageflow?sslmode=require
